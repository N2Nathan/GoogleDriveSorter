# Google OAuth Credentials
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_REDIRECT_URI=http://localhost:3001/auth/google/callback

# OpenAI Configuration (optional but recommended for AI features)
# For OpenAI:
OPENAI_API_KEY=your_openai_api_key_here
# OPENAI_BASE_URL=https://api.openai.com/v1

# For local LLM (vLLM, LocalAI, Ollama, etc.):
# OPENAI_API_KEY=dummy-key-for-local-llm
# OPENAI_BASE_URL=http://localhost:8000/v1

# Session Secret (generate with: openssl rand -base64 32)
SESSION_SECRET=your_random_session_secret_here_change_this_to_random_string

# URLs
FRONTEND_URL=http://localhost:3000
VITE_API_URL=http://localhost:3001

# Optional: Backend port (default: 3001)
# PORT=3001

# Optional: Node environment
# NODE_ENV=production
